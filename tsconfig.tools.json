{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": false,
    "types": ["node", "bun"]
  },
  "include": ["scripts/**/*.ts", "test/**/*.ts", "src/**/*.ts"]
}
