{
  "name": "humagent",
  "version": "0.1.0",
  "description": "Work with your AI agent through pages, prototypes, and local apps.",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "humagent": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/runtime/server.d.ts",
      "import": "./dist/runtime/server.js"
    },
    "./protocol": {
      "types": "./dist/runtime/protocol.d.ts",
      "import": "./dist/runtime/protocol.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "docs/CLI.md",
    "docs/SDK.md",
    "docs/SECURITY.md",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/souljorje/humagent.git"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "lint": "bunx --bun --no-install oxlint src scripts test",
    "format": "bunx --bun --no-install oxfmt src test scripts tsconfig*.json package.json",
    "format:check": "bunx --bun --no-install oxfmt --check src test scripts tsconfig*.json package.json",
    "typecheck": "bun ./node_modules/typescript/bin/tsc -p tsconfig.tools.json",
    "test": "bun run build && bun test ./test/*.test.ts --timeout 15000",
    "test:browser": "bun run build && bun run test:browser:built",
    "test:browser:built": "playwright test --config test/playwright.config.ts",
    "check": "bun run format:check && bun run build && bun run typecheck && bun test ./test/*.test.ts --timeout 15000",
    "prepack": "bun run build",
    "test:install": "node test/install.ts",
    "test:runners": "bun test/runners.ts",
    "check:release": "bun run check && bun run test:browser:built && bun pm pack --ignore-scripts && bun run test:install && bun run test:runners"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/bun": "1.4.4",
    "@types/node": "25.1.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "5.8.3"
  },
  "homepage": "https://github.com/souljorje/humagent#readme",
  "bugs": {
    "url": "https://github.com/souljorje/humagent/issues"
  },
  "author": "Georgii Bukharov",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "generative-ui",
    "annotations",
    "prototypes",
    "human-in-the-loop"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "hono": "4.13.16"
  }
}
