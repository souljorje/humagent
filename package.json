{
  "name": "humagent",
  "version": "0.2.0",
  "description": "Comment on, rewrite, and answer local pages and apps, then send your AI agent one structured review.",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "humagent": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/runtime/server.d.ts",
      "import": "./dist/runtime/server.js"
    },
    "./feedback": {
      "types": "./dist/shared/feedback.d.ts",
      "import": "./dist/shared/feedback.js"
    }
  },
  "files": [
    "dist",
    "!dist/examples/*.d.ts",
    "docs",
    "CONTRIBUTING.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/souljorje/humagent.git"
  },
  "scripts": {
    "changeset": "changeset",
    "version:packages": "changeset version && bun install --lockfile-only --ignore-scripts",
    "build": "rm -rf dist && tsc && cp src/ui/*.{html,css} dist/ui/ && cp src/examples/*.{html,css} dist/examples/",
    "lint": "oxlint src test",
    "format": "bun fmt src test tsconfig*.json package.json turbo.json",
    "format:check": "bun fmt --check src test tsconfig*.json package.json turbo.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "bun run check test:browser:built",
    "test:browser:built": "playwright test --config test/playwright.config.ts",
    "check": "turbo run format:check lint build typecheck test:fast --output-logs=new-only",
    "test:fast": "bun test ./test/*.test.ts --timeout 15000",
    "prepack": "bun run build",
    "release": "changeset publish",
    "precheck": "mkdir -p .turbo && node --version > .turbo/node-version",
    "prepublishOnly": "playwright install --with-deps --only-shell chromium && bun run test --force"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.65.1",
    "@types/bun": "1.4.4",
    "@types/node": "25.1.0",
    "oxlint": "1.90.0",
    "turbo": "2.11.12",
    "typescript": "5.8.3"
  },
  "homepage": "https://github.com/souljorje/humagent#readme",
  "bugs": {
    "url": "https://github.com/souljorje/humagent/issues"
  },
  "author": "Georgii Bukharov",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "generative-ui",
    "annotations",
    "prototypes",
    "human-in-the-loop"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "hono": "4.13.16"
  }
}
