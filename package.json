{
  "name": "humagent",
  "version": "0.3.0",
  "description": "Comment on, rewrite, and answer local pages and apps, then send your AI agent structured feedback.",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "humagent": "dist/node/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/node/server.d.ts",
      "import": "./dist/node/server.js"
    },
    "./feedback": {
      "types": "./dist/node/feedback.d.ts",
      "import": "./dist/node/feedback.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "CONTRIBUTING.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/souljorje/humagent.git"
  },
  "scripts": {
    "changeset": "changeset",
    "version:packages": "changeset version && bun install --lockfile-only --ignore-scripts",
    "dev": "vite",
    "build": "vite build && vite build src/examples",
    "build:standalone": "bun run build && bun scripts/standalone/build.ts",
    "test:standalone": "bun test/standalone.ts",
    "lint": "oxlint src test scripts/standalone vite.config.ts",
    "format": "bun fmt src test scripts/standalone vite.config.ts tsconfig*.json package.json turbo.json",
    "format:check": "bun fmt --check src test scripts/standalone vite.config.ts tsconfig*.json package.json turbo.json",
    "typecheck": "tsrs && tsrs -p tsconfig.test.json && tsrs -p scripts/standalone/tsconfig.json",
    "test": "bun run check test:browser:built",
    "test:browser:built": "playwright test --config test/playwright.config.ts",
    "check": "turbo run format:check lint build typecheck test:fast --continue=$([ -n \"$CI\" ] && echo never || echo dependencies-successful)",
    "test:fast": "bun test ./test/*.test.ts --timeout 15000 ${CI:+--bail=1}",
    "prepack": "bun run build",
    "release": "changeset publish",
    "precheck": "mkdir -p .turbo && node --version > .turbo/node-version",
    "prepublishOnly": "playwright install --with-deps --only-shell chromium && bun run test --force"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.65.1",
    "@types/bun": "1.4.4",
    "@types/node": "25.1.0",
    "oxlint": "1.90.0",
    "rolldown-plugin-dts": "0.30.2",
    "tsrs": "7.1.0-beta.tsrs5",
    "turbo": "2.11.12",
    "vite": "8.3.8"
  },
  "homepage": "https://github.com/souljorje/humagent#readme",
  "bugs": {
    "url": "https://github.com/souljorje/humagent/issues"
  },
  "author": "Georgii Bukharov",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "generative-ui",
    "annotations",
    "prototypes",
    "human-in-the-loop"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "hono": "4.13.16"
  }
}
