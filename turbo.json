{
  "$schema": "https://turborepo.dev/schema.json",
  "remoteCache": {
    "enabled": false
  },
  "globalEnv": ["CI", "npm_config_user_agent", "NODE_OPTIONS", "BUN_OPTIONS"],
  "tasks": {
    "format:check": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**"]
    },
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!docs/**",
        "!test/**",
        "!tsconfig.test.json"
      ],
      "outputs": ["dist/**"],
      "dependsOn": ["clean:build"]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**"],
      "dependsOn": ["build"]
    },
    "test:fast": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**"],
      "dependsOn": ["build"]
    },
    "test:browser:built": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["PLAYWRIGHT_*", "PWDEBUG"]
    },
    "clean:build": {
      "inputs": ["package.json"],
      "outputs": [],
      "cache": false
    }
  },
  "globalDependencies": [".turbo/runtime.json", "toolchain.json"]
}
